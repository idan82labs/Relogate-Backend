# ===========================================
# Relogate Backend Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# Application
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Supabase Auth Configuration
# Get these from: Supabase Dashboard > Settings > API
# Supports both formats:
#   - New keys (recommended): sb_publishable_... and sb_secret_...
#   - Legacy JWT keys: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Database Connection (for Drizzle ORM)
# Get from: Supabase Dashboard > Settings > Database > Connection string
# Use "Transaction" pooler for serverless, "Session" for long-lived connections
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# CORS
CORS_ORIGIN=http://localhost:3000

# Stripe Payment Configuration
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# Webhook secret from: stripe listen --forward-to localhost:3001/api/v1/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

